{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATA-GUI",
        "width": 1280,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d0e"
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
